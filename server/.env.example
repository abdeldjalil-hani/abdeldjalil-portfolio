# Server environment configuration
# Copy this file to server/.env and fill in real values.
# NEVER commit server/.env — it contains real credentials.

# ---- Database ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=youruser_portfolio
DB_USER=youruser_dbuser
DB_PASSWORD=your_password
# Optional full connection URL (overrides individual DB_* vars if set)
DATABASE_URL=
# Set to "true" only to non-destructively sync tables at boot (dev only).
# In production this is disabled by default.
DB_SYNC=false

# ---- Authentication ----
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
COOKIE_SECURE=false
COOKIE_NAME=ah_portfolio_token

# ---- App ----
NODE_ENV=development
PORT=5000
# Frontend origin(s) allowed to call the API (comma-separated is supported).
# Local dev: http://localhost:5173  |  Production: https://yourdomain.com
CLIENT_URL=http://localhost:5173
# Public base URL of the site (used in sitemap/canonical URLs)
SITE_URL=http://localhost:5173
# Absolute URL prefix for uploaded files
PUBLIC_URL=http://localhost:5000

# ---- Rate limiting ----
RATE_LIMIT_LOGIN=50
RATE_LIMIT_CONTACT=20

# ---- Uploads ----
MAX_FILE_SIZE_MB=5