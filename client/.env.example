# Client-side environment variables (optional)
# In development the Vite proxy forwards /api and /uploads to the Express
# server on http://localhost:5000, so you usually do NOT need these.

# The API base URL. Leave empty to use same-origin (production / proxied dev).
VITE_API_URL=

# The backend proxy target when running `npm run dev`
VITE_PROXY_TARGET=http://localhost:5000