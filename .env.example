# Server environment configuration
# Copy this file to .env and fill in real values.

# ---- Database ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=portfolio_db
DB_USER=root
DB_PASSWORD=your_password
# Optional full connection URL (overrides individual DB_* vars if set)
DATABASE_URL=

# ---- Authentication ----
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
# Session cookie options
COOKIE_SECURE=false
# Painful-to-guess cookie name
COOKIE_NAME=ah_portfolio_token

# ---- App ----
NODE_ENV=development
PORT=5000
# Public base URL of the site (used in sitemap/canonical URLs)
SITE_URL=http://localhost:5173
# Absolute URL prefix for uploaded files
PUBLIC_URL=http://localhost:5000

# ---- Rate limiting ----
RATE_LIMIT_LOGIN=50
RATE_LIMIT_CONTACT=20

# ---- Uploads ----
MAX_FILE_SIZE_MB=5